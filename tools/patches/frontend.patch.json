     "new": "      </template>\n    </div>\n\n        <!-- Expiry alerts modal (added) -->\n    <template x-if=\"expOpen\">\n      <div class=\"modal-overlay\" @click.self=\"expOpen = false\">\n        <div class=\"modal\" style=\"max-width:640px;\">\n          <h2>פגי תוקף ובדרך לפקוע</h2>\n          <p class=\"muted\" style=\"font-size:13px;margin-top:0;\" x-text=\"'התראה ' + (xFlags.expiry_days || 30) + ' ימים מראש'\"></p>\n          <template x-if=\"expList.length > 0\">\n            <div style=\"max-height:60vh;overflow-y:auto;\">\n              <table class=\"data\">\n                <thead><tr><th>שם</th><th>פרויקט</th><th>מה</th><th>תוקף</th><th>מצב</th></tr></thead>\n                <tbody>\n                  <template x-for=\"(a, i) in expList\" :key=\"i\">\n                    <tr>\n                      <td><a href=\"#\" @click.prevent=\"expOpen = false; showDetails(a.v)\" x-text=\"a.v.name\"></a></td>\n                      <td x-text=\"a.project || '—'\"></td>\n                      <td x-text=\"a.title\"></td>\n                      <td x-text=\"a.info.status === 'unreadable' ? a.info.raw : Kav1.extras.fmtDate(a.info.date)\"></td>\n                      <td><span class=\"badge\" :class=\"Kav1.extras.expiryBadge('', a.info).cls\"\n                                x-text=\"a.info.status === 'expired' ? 'פג לפני ' + (-a.info.days) + ' ימים' : (a.info.status === 'expiring' ? 'בעוד ' + a.info.days + ' ימים' : 'תאריך לא קריא')\"></span></td>\n                    </tr>\n                  </template>\n                </tbody>\n              </table>\n            </div>\n          </template>\n          <template x-if=\"expList.length === 0\"><p class=\"muted\">אין תוקפים לטיפול.</p></template>\n          <div class=\"modal-actions\"><button class=\"btn btn-ghost\" @click=\"expOpen = false\">סגירה</button></div>\n        </div>\n      </div>\n    </template>\n\n    <!-- Visitor details modal -->\n"
    },
