     "new": "  },\n};\n\n// ---------------------------------------------------------------------------\n// Optional additions (visitor lists: project / expiry / latest entry first, and\n// the \"Control & Locations\" menu link). Purely additive: if anything here fails,\n// the page behaves exactly as before.\n// ---------------------------------------------------------------------------\nKav1.extras = {\n  _flags: null,\n  async flags() {\n    if (this._flags) return this._flags;\n    try { this._flags = await Kav1.get(\"locations/flags\"); }\n    catch (e) { this._flags = { locations_enabled: false, group_by_project: false, require_infosec: false, expiry_days: 30 }; }\n    return this._flags;\n  },\n  // {dbid: {last_entry, project, infosec, approval, classification}} - {} on any failure\n  async overview() {\n    try {\n      const res = await Kav1.get(\"visitors/overview\");\n      const map = {};\n      (res.rows || []).forEach(r => { map[r.dbid] = r; });\n      return map;\n    } catch (e) { return {}; }\n  },\n  fmtDate(iso) { return iso ? iso.slice(8, 10) + \".\" + iso.slice(5, 7) + \".\" + iso.slice(0, 4) : \"\"; },\n  // one expiry -> {label, cls}; cls is a badge colour class, label may be \"\" when there is nothing to show\n  expiryBadge(title, info) {\n    if (!info) return { label: \"\", cls: \"\" };\n    if (info.status === \"unreadable\") return { label: title + \": \" + info.raw, cls: \"badge-out\" };\n    const when = Kav1.extras.fmtDate(info.date);\n    const cls = info.status === \"expired\" ? \"badge-inactive\" : info.status === \"expiring\" ? \"badge-warn\" : \"badge-in\";\n    return { label: title + \" \" + when, cls };\n  },\n  esc(t) { return String(t == null ? \"\" : t).replace(/[&<>\"']/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c])); },\n  // the two expiry badges of one visitor as ready, escaped HTML (one binding per row keeps big lists fast)\n  badgesHtml(r) {\n    if (!r) return \"\";\n    return [Kav1.extras.expiryBadge(\"אישור\", r.approval), Kav1.extras.expiryBadge('סב\"ט', r.classification)]\n      .filter(b => b.label)\n      .map(b => '<span class=\"badge ' + b.cls + '\">' + Kav1.extras.esc(b.label) + \"</span>\")\n      .join(\"\");\n  },\n  // visitors sorted latest entry first, optional project filter, optional grouping by project.\n  // Each visitor row is a copy with _p (project) and _b (badges html) ready for the page.\n  arrange(list, ov, projectFilter, group, collapsed) {\n    const want = projectFilter === \"__none__\" ? \"\" : projectFilter;\n    let items = [];\n    for (const v of list) {\n      const r = ov[v.dbid];\n      const project = (r && r.project) || \"\";\n      if (projectFilter && project !== want) continue;\n      items.push({ last: (r && r.last_entry) || \"\", project, row: Object.assign({}, v, { _p: project || \"—\", _b: Kav1.extras.badgesHtml(r) }) });\n    }\n    items.sort((a, b) => (a.last < b.last ? 1 : a.last > b.last ? -1 : 0));\n    if (!group) return items.map(i => i.row);\n    const groups = new Map();\n    items.forEach(i => {\n      if (!groups.has(i.project)) groups.set(i.project, []);\n      groups.get(i.project).push(i.row);\n    });\n    const out = [];\n    groups.forEach((members, k) => {\n      const key = k || \"__none__\";\n      out.push({ __g: true, key, title: k || \"ללא פרויקט\", count: members.length });\n      if (!collapsed[key]) members.forEach(m => out.push(m));\n    });\n    return out;\n  },\n  projects(ov) {\n    const set = new Set();\n    Object.values(ov).forEach(r => { if (r.project) set.add(r.project); });\n    return [...set].sort();\n  },\n  // visitors with an expired / expiring / unreadable expiry, soonest first\n  alerts(list, ov) {\n    const out = [];\n    list.forEach(v => {\n      const r = ov[v.dbid]; if (!r) return;\n      [[\"אישור\", r.approval], ['סב\"ט', r.classification]].forEach(([title, info]) => {\n        if (info && info.status !== \"ok\") out.push({ v, title, info, days: info.days === null ? 9e9 : info.days, project: r.project });\n      });\n    });\n    return out.sort((a, b) => a.days - b.days);\n  },\n};\n\n// \"Control & Locations\" link in every page's top bar, only when the admin turned it on\ndocument.addEventListener(\"DOMContentLoaded\", async () => {\n  try {\n    const nav = document.querySelector(\".topbar nav\");\n    if (!nav || location.pathname.endsWith(\"/login.html\")) return;\n    const me = await Kav1.me();\n    if (!me || !(me.permissions || []).includes(\"locations.view\")) return;\n    const f = await Kav1.extras.flags();\n    if (!f.locations_enabled) return;\n    const a = document.createElement(\"a\");\n    a.href = \"/locations.html\";\n    a.textContent = \"שליטה ומיקומים\";\n    if (location.pathname.endsWith(\"/locations.html\")) a.className = \"active\";\n    nav.appendChild(a);\n  } catch (e) { /* optional feature: never break the page */ }\n});\n"
