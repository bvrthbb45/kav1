   "path": "locations.html",
   "create": "<!DOCTYPE html>\n<html lang=\"he\" dir=\"rtl\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Kav1 - שליטה ומיקומים</title>\n  <link rel=\"stylesheet\" href=\"static/css/kav1.css?v=20261029\">\n  <style>\n    .split { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 16px; }\n    @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }\n    .stage { position: relative; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; line-height: 0; display: inline-block; max-width: 100%; }\n    .stage img { display: block; max-width: 100%; height: auto; user-select: none; -webkit-user-drag: none; }\n    .stage.placing { outline: 2px dashed var(--accent); cursor: crosshair; }\n    .pt { position: absolute; width: 14px; height: 14px; border-radius: 50%; background: var(--danger); border: 2px solid #fff; transform: translate(-50%, -50%); cursor: pointer; }\n    .pt.sel { background: var(--accent); width: 18px; height: 18px; }\n    .pt span { position: absolute; top: 16px; right: 0; white-space: nowrap; font-size: 12px; line-height: 1.3; background: rgba(0,0,0,0.8); color: #fff; padding: 1px 6px; border-radius: 4px; }\n    .tbl-wrap { overflow-x: auto; }\n    tr.sel td { background: #2f3b4d; }\n    tr.clickable { cursor: pointer; }\n    .wrap { flex-wrap: wrap; }\n  </style>\n</head>\n<body>\n  <div x-data=\"locationsPage()\" x-init=\"init()\" x-cloak>\n\n    <div class=\"topbar\">\n      <div class=\"brand\">\n        <span class=\"logo\" x-text=\"brand.logo_text || 'K1'\"></span>\n        <span x-text=\"brand.system_name || 'Kav1'\"></span>\n      </div>\n      <nav>\n        <a x-show=\"can('control.panel') || can('visitor.entry_exit')\" href=\"index.html\">פאנל שליטה</a>\n        <a x-show=\"can('visitor.view')\" href=\"visitors.html\">מבקרים</a>\n        <a x-show=\"can('logs.view')\" href=\"logs.html\">לוגים</a>\n        <a x-show=\"can('reports.view')\" href=\"reports.html\">דוחות</a>\n        <a x-show=\"can('roles.manage') || can('users.view') || can('admin.dashboard')\" href=\"admin/index.html\">ניהול</a>\n      </nav>\n      <div class=\"user-area\">\n        <span x-text=\"me ? (me.full_name || me.username) : ''\"></span>\n        <span class=\"muted\" x-text=\"me ? '· ' + me.role_name : ''\"></span>\n        <button class=\"btn btn-sm btn-ghost\" @click=\"Kav1.logout()\">יציאה</button>\n      </div>\n    </div>\n\n    <div class=\"page\">\n      <div class=\"page-head\">\n        <h1>שליטה ומיקומים</h1>\n        <div class=\"row\">\n          <select x-model=\"projFilter\" style=\"width:170px;\">\n            <option value=\"\">כל הפרויקטים</option>\n            <template x-for=\"p in projects\" :key=\"p\"><option :value=\"p\" x-text=\"p\"></option></template>\n          </select>\n        </div>\n      </div>\n\n      <template x-if=\"loaded && !enabled\">\n        <div class=\"empty-state\"><p>הפיצ'ר \"שליטה ומיקומים\" אינו מופעל. מנהל המערכת יכול להפעיל אותו במסך ההגדרות.</p></div>\n      </template>\n\n      <template x-if=\"loaded && enabled\">\n        <div class=\"split\">\n          <!-- map -->\n          <div class=\"card\">\n            <div class=\"row wrap\" style=\"margin-bottom:10px;\">\n              <select x-model.number=\"mapId\" x-effect=\"$nextTick(() => $el.value = mapId)\" style=\"width:180px;\" @change=\"selectMap()\">\n                <template x-for=\"m in maps\" :key=\"m.id\"><option :value=\"m.id\" x-text=\"m.name\"></option></template>\n              </select>\n              <template x-if=\"canEdit()\">\n                <div class=\"row wrap\">\n                  <button class=\"btn btn-sm\" @click=\"renameMap()\" :disabled=\"!mapId\">שינוי שם</button>\n                  <button class=\"btn btn-sm btn-danger\" @click=\"deleteMap()\" :disabled=\"!mapId\">מחיקת מפה</button>\n                </div>\n              </template>\n            </div>\n            <template x-if=\"canEdit()\">\n              <div class=\"row wrap\" style=\"margin-bottom:10px;\">\n                <input type=\"file\" accept=\"image/png,image/jpeg\" @change=\"onFile($event)\" style=\"font-size:13px;width:auto;\">\n                <input type=\"text\" x-model=\"newMapName\" placeholder=\"שם למפה\" style=\"width:150px;\">\n                <button class=\"btn btn-primary btn-sm\" @click=\"uploadMap()\" :disabled=\"!file\">העלאת מפה</button>\n              </div>\n            </template>\n            <template x-if=\"canEdit()\">\n              <div class=\"row wrap\" style=\"margin-bottom:10px;\">\n                <button class=\"btn btn-sm\" @click=\"startPlace()\" :disabled=\"!selected || !mapId\">מקם נקודה לשורה שנבחרה</button>\n                <button class=\"btn btn-sm\" @click=\"clearPoint()\" :disabled=\"!selected || selected.x == null\">הסר נקודה</button>\n                <span class=\"muted\" style=\"font-size:12px;\" x-text=\"hint\"></span>\n              </div>\n            </template>\n            <p x-show=\"msg\" x-text=\"msg\" :style=\"'font-size:13px;margin:0 0 10px;color:' + (msgErr ? 'var(--danger)' : 'var(--success)')\"></p>\n            <template x-if=\"mapId\">\n              <div class=\"stage\" :class=\"placing ? 'placing' : ''\" @click=\"onStage($event)\" x-ref=\"stage\">\n                <img :src=\"'/locations/maps/' + mapId + '/image'\" alt=\"\" x-ref=\"img\">\n                <template x-for=\"e in mapEntries\" :key=\"e.id\">\n                  <div class=\"pt\" :class=\"e.id === selId ? 'sel' : ''\" :style=\"'left:' + (e.x * 100) + '%;top:' + (e.y * 100) + '%'\"\n                       @click.stop=\"select(e.id)\"><span x-text=\"e.project + (e.escort_name ? ' · ' + e.escort_name : '')\"></span></div>\n                </template>\n              </div>\n            </template>\n            <template x-if=\"!mapId\"><p class=\"muted\">אין מפה להצגה.</p></template>\n          </div>\n\n          <!-- escorts and locations -->\n          <div class=\"card\">\n            <template x-if=\"canEdit()\">\n              <div class=\"row wrap\" style=\"margin-bottom:10px;\">\n                <input type=\"text\" x-model=\"nProj\" placeholder=\"פרויקט\" list=\"locProjects\" style=\"flex:1;min-width:90px;\">\n                <datalist id=\"locProjects\"><template x-for=\"p in projects\" :key=\"p\"><option :value=\"p\"></option></template></datalist>\n                <input type=\"text\" x-model=\"nEsc\" placeholder=\"מלווה\" style=\"flex:1;min-width:90px;\">\n                <input type=\"text\" x-model=\"nLoc\" placeholder=\"מיקום\" style=\"flex:1;min-width:90px;\">\n                <button class=\"btn btn-primary btn-sm\" @click=\"addEntry()\">הוסף מלווה ומיקום</button>\n              </div>\n            </template>\n            <p x-show=\"entMsg\" x-text=\"entMsg\" style=\"font-size:13px;margin:0 0 10px;color:var(--danger);\"></p>\n            <div class=\"tbl-wrap\">\n              <table class=\"data\">\n                <thead><tr><th>מלווה</th><th>מיקום</th><th>נקודה</th><th></th></tr></thead>\n                <tbody>\n                  <template x-for=\"r in rows\" :key=\"r.__g ? 'g:' + r.key : r.id\">\n                    <tr :class=\"(r.__g ? 'grp-row' : 'clickable') + (r.id === selId ? ' sel' : '')\" @click=\"r.__g ? toggle(r.key) : select(r.id)\">\n                      <td x-show=\"r.__g\" colspan=\"4\" x-text=\"r.__g ? (collapsed[r.key] ? '◀ ' : '▼ ') + r.title + ' (' + r.count + ')' : ''\"></td>\n                      <td x-show=\"!r.__g\">\n                        <template x-if=\"canEdit() && !r.__g\"><input type=\"text\" x-model=\"r.escort_name\" maxlength=\"200\" @click.stop></template>\n                        <template x-if=\"!canEdit() && !r.__g\"><span x-text=\"r.escort_name\"></span></template>\n                      </td>\n                      <td x-show=\"!r.__g\">\n                        <template x-if=\"canEdit() && !r.__g\"><input type=\"text\" x-model=\"r.location_text\" maxlength=\"200\" @click.stop></template>\n                        <template x-if=\"!canEdit() && !r.__g\"><span x-text=\"r.location_text\"></span></template>\n                      </td>\n                      <td x-show=\"!r.__g\" x-text=\"r.x == null ? '—' : '✔'\"></td>\n                      <td x-show=\"!r.__g\">\n                        <div class=\"row\" x-show=\"canEdit()\">\n                          <button class=\"btn btn-sm\" @click.stop=\"saveEntry(r)\">שמירה</button>\n                          <button class=\"btn btn-sm btn-danger\" @click.stop=\"removeEntry(r)\">מחיקה</button>\n                        </div>\n                      </td>\n                    </tr>\n                  </template>\n                </tbody>\n              </table>\n              <template x-if=\"rows.length === 0\"><p class=\"muted\" style=\"text-align:center;\">אין שורות להצגה.</p></template>\n            </div>\n          </div>\n        </div>\n      </template>\n    </div>\n  </div>\n\n  <script src=\"static/js/kav1.js?v=20261029\"></script>\n  <script>\n    function locationsPage() {\n      return {\n        Kav1, me: null, brand: {}, loaded: false, enabled: false,\n        maps: [], entries: [], mapId: null, selId: null, placing: false,\n        projFilter: \"\", collapsed: {}, hint: \"בחר שורה בטבלה, לחץ \\\"מקם\\\" ואז לחץ על המפה.\",\n        file: null, newMapName: \"\", msg: \"\", msgErr: false, entMsg: \"\",\n        nProj: \"\", nEsc: \"\", nLoc: \"\",\n\n        can(perm) { return !!(this.me && this.me.permissions && this.me.permissions.includes(perm)); },\n        canEdit() { return this.can(\"locations.edit\"); },\n\n        get projects() { return [...new Set(this.entries.map(e => e.project))].sort(); },\n        get selected() { return this.entries.find(e => e.id === this.selId) || null; },\n        get mapEntries() { return this.entries.filter(e => e.map_id === this.mapId && e.x != null && (!this.projFilter || e.project === this.projFilter)); },\n        get rows() {\n          const list = this.entries.filter(e => !this.projFilter || e.project === this.projFilter);\n          const groups = new Map();\n          list.forEach(e => { if (!groups.has(e.project)) groups.set(e.project, []); groups.get(e.project).push(e); });\n          const out = [];\n          groups.forEach((members, k) => {\n            out.push({ __g: true, key: k, title: k, count: members.length });\n            if (!this.collapsed[k]) members.forEach(m => out.push(m));\n          });\n          return out;\n        },\n\n        async init() {\n          try { this.me = await Kav1.me(); } catch (e) { location.href = \"/login.html\"; return; }\n          if (!this.can(\"locations.view\")) { location.href = \"/index.html\"; return; }\n          try { this.brand = await Kav1.get(\"auth/branding\"); } catch (e) {}\n          const flags = await Kav1.extras.flags();\n          this.enabled = !!flags.locations_enabled;\n          if (this.enabled) await this.refresh();\n          this.loaded = true;\n        },\n\n        async refresh() {\n          try {\n            [this.maps, this.entries] = await Promise.all([Kav1.get(\"locations/maps\"), Kav1.get(\"locations/entries\")]);\n            if (!this.maps.some(m => m.id === this.mapId)) this.mapId = this.maps.length ? this.maps[0].id : null;\n          } catch (e) { if (e.message !== \"unauthorized\") Kav1.toast(e.message, \"error\"); }\n        },\n        selectMap() { this.placing = false; },\n        toggle(k) { this.collapsed = { ...this.collapsed, [k]: !this.collapsed[k] }; },\n        select(id) { this.selId = id; this.placing = false; },\n\n        onFile(ev) { this.file = ev.target.files[0] || null; },\n        async uploadMap() {\n          const f = this.file; if (!f) return;\n          if (f.size > 15 * 1024 * 1024) { this.msgErr = true; this.msg = \"הקובץ גדול מ-15MB\"; return; }\n          const name = (this.newMapName || f.name.replace(/\\.[^.]+$/, \"\")).trim();\n          try {\n            const res = await fetch(\"/locations/maps?name=\" + encodeURIComponent(name), { method: \"POST\", body: f, credentials: \"same-origin\" });\n            const data = await res.json().catch(() => ({}));\n            if (!res.ok) throw new Error(data.detail || \"ההעלאה נכשלה\");\n            this.msgErr = false; this.msg = \"המפה הועלתה\"; this.file = null; this.newMapName = \"\";\n            await this.refresh(); this.mapId = data.id;\n          } catch (e) { this.msgErr = true; this.msg = e.message; }\n        },\n        async renameMap() {\n          const cur = this.maps.find(m => m.id === this.mapId); if (!cur) return;\n          const n = window.prompt(\"שם חדש למפה:\", cur.name); if (!n) return;\n          try { await Kav1.put(\"locations/maps/\" + this.mapId, { name: n }); await this.refresh(); } catch (e) { this.msgErr = true; this.msg = e.message; }\n        },\n        async deleteMap() {\n          if (!this.mapId || !confirm(\"למחוק את המפה? הנקודות עליה יוסרו, השורות עצמן יישארו.\")) return;\n          try { await Kav1.del(\"locations/maps/\" + this.mapId); await this.refresh(); } catch (e) { this.msgErr = true; this.msg = e.message; }\n        },\n\n        async addEntry() {\n          this.entMsg = \"\";\n          try {\n            const r = await Kav1.post(\"locations/entries\", { project: this.nProj, escort_name: this.nEsc, location_text: this.nLoc });\n            this.nEsc = \"\"; this.nLoc = \"\"; await this.refresh(); this.selId = r.id;\n          } catch (e) { this.entMsg = e.message; }\n        },\n        body(e, patch) { return { project: e.project, escort_name: e.escort_name, location_text: e.location_text, map_id: e.map_id, x: e.x, y: e.y, ...patch }; },\n        async saveEntry(e, patch) {\n          this.entMsg = \"\";\n          try { await Kav1.put(\"locations/entries/\" + e.id, this.body(e, patch || {})); Kav1.toast(\"נשמר\"); await this.refresh(); }\n          catch (er) { this.entMsg = er.message; }\n   