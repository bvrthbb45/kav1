     "old": "        ws: null,\n\n",
     "new": "        ws: null,\n        // --- added: project / expiry / latest-entry-first ---\n        ov: {}, xFlags: {}, projFilter: \"\", projects: [], collapsed: {}, expOpen: false,\n        rows: [], expList: [],\n        // rows / expList are rebuilt only when their inputs change (not on every binding read)\n        refreshRows() {\n          if (!Kav1.extras) { this.rows = this.filtered; this.expList = []; return; }   // old kav1.js: plain list\n          this.rows = Kav1.extras.arrange(this.filtered, this.ov, this.projFilter, !!this.xFlags.group_by_project, this.collapsed);\n          this.expList = Kav1.extras.alerts(this.allVisitors, this.ov);\n        },\n        toggleGroup(k) { this.collapsed = { ...this.collapsed, [k]: !this.collapsed[k] }; },\n        async loadExtras() {\n          // the additions are optional: if anything fails here, the list is shown as it always was\n          try {\n            this.xFlags = await Kav1.extras.flags();\n            this.ov = await Kav1.extras.overview();\n            this.projects = Kav1.extras.projects(this.ov);\n          } catch (e) {\n            this.xFlags = {}; this.ov = {}; this.projects = [];\n          }\n        },\n\n"
