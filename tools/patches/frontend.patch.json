ct\", \"projects\"],\n            infosec: [\"אבטחת מידע\"],\n            approval: [\"תוקף אישור\", \"תוקף אבטחת מידע\", \"תאריך תום אישור\"],\n            cls: ['תוקף סב\"ט', \"תוקף סב״ט\", \"תוקף סיווג\", \"תוקף סיווג בטחוני\"],\n          };\n          const props = Object.assign({}, v.properties || {});\n          const find = (field) => Object.keys(props).find(k => ALIASES[field].includes(k.trim()) || ALIASES[field].includes(k.trim().toLowerCase()));\n          const o = this.ov[v.dbid] || {};\n          const iso = { approval: (o.approval && o.approval.date) || null, cls: (o.classification && o.classification.date) || null };\n          for (const field of [\"project\", \"infosec\", \"approval\", \"cls\"]) {\n            const k = find(field);\n            if (k === undefined) continue;\n            const val = String(props[k] == null ? \"\" : props[k]).trim();\n            if ((field === \"approval\" || field === \"cls\") && !iso[field]) continue;   // unreadable date: leave it in the free list\n            this.mfKeys[field] = k;\n            if (field === \"project\") this.mf.project = val;\n            else if (field === \"infosec\") this.mf.infosec = val;\n            else if (field === \"approval\") this.mf.approval = iso.approval;\n            else { this.mf.hasCls = true; this.mf.cls = iso.cls; }\n            delete props[k];\n          }\n          return props;\n        },\n        mergeManaged(obj) {\n          const put = (field, fallback, value) => { if (value) obj[this.mfKeys[field] || fallback] = value; };\n          put(\"project\", \"פרויקט\", (this.mf.project || \"\").trim());\n          put(\"infosec\", \"אבטחת מידע\", this.mf.infosec);\n          put(\"approval\", \"תוקף אישור\", this.mf.approval);\n          put(\"cls\", 'תוקף סב\"ט', this.mf.hasCls ? this.mf.cls : \"\");\n          return obj;\n        },\n\n"
