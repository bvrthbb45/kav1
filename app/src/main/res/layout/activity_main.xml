<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            style="@style/BodyText"
            android:text="@string/main_title"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnScan"
            style="@style/BigButton"
            android:layout_marginTop="24dp"
            android:text="@string/btn_scan" />

        <Button
            android:id="@+id/btnManualEntry"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_manual_entry"
            android:textSize="@dimen/body_text" />

        <Button
            android:id="@+id/btnSync"
            style="@style/BigButton"
            android:text="@string/btn_manual_sync" />

        <Button
            android:id="@+id/btnDashboard"
            style="@style/BigButton"
            android:text="@string/btn_dashboard" />

        <Button
            android:id="@+id/btnAdmin"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_admin"
            android:textSize="@dimen/body_text" />

        <ProgressBar
            android:id="@+id/syncProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtPending"
            style="@style/BodyText"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/txtPendingEdits"
            style="@style/BodyText"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtFailed"
            style="@style/BodyText"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/borrow"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtLocalData"
            style="@style/BodyText"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/txtLastSync"
            style="@style/BodyText"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>
