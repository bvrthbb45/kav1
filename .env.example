# Template for the /watch (claude-video) skill.
# Copy this file to .env and fill in your key(s), or set the same
# variables in ~/.config/watch/.env (created automatically on first
# /watch run) — the skill checks the repo-local .env as a fallback.

# Whisper transcription fallback (used only when native captions are
# unavailable). The skill prefers Groq when both are set.
GROQ_API_KEY=
OPENAI_API_KEY=

# Requested placeholder for a Google AI Studio / Gemini key.
# NOTE: the installed watch skill (scripts/whisper.py, config.py) does
# NOT read this variable — it only supports Groq and OpenAI Whisper for
# transcription. Setting this alone will not enable any functionality;
# it is kept here only as a placeholder in case a future version of the
# skill (or another tool in this repo) adds Gemini support.
GEMINI_API_KEY=
