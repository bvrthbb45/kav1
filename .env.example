# Kav1 configuration reference.
#
# Kav1 does NOT load a .env file today: there is no python-dotenv in the
# requirements. This file documents every setting that exists, so you know
# what can be tuned and how. Copy to `.env` if you want to keep your own notes
# (it is git-ignored) and export the variables in the shell / .bat that starts
# the server.

# --- Read by the application -------------------------------------------------
# backend/app/version.py: "true" makes get_version() return the bare git SHA
# from version.txt instead of "unreleased-<sha>". Set by CI for release builds.
RELEASE_BUILD=false

# --- Read by tools/*.py ------------------------------------------------------
# Absolute path of the SQLite file when auto-discovery should not be used (or
# when more than one local_database.db exists on the machine).
# KAV1_DB=C:\Users\<you>\AppData\Roaming\Kav1\server\local_database.db

# --- NOT environment variables (for reference) ------------------------------
# Server bind address / port: command-line flags of the server
#     server.exe --host 0.0.0.0 --port 3000      (python backend/server.py ...)
# Database location: hard-coded in backend/app/database.py and
#     backend/alembic.ini as  sqlite:///./local_database.db
#     i.e. relative to the server's CURRENT WORKING DIRECTORY.
# Client -> server address: asked in the connection dialog at start-up
#     (default localhost:3000, frontend/app/core/settings.py).
